# ==============================================================================
# RelayPoint - Environment Variables Template
# Copy this file to .env and configure the appropriate values.
# WARNING: NEVER commit actual credentials or API keys to version control.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Secret Key (for session encryption / cryptographic operations)
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key

# GitHub Integration
# Personal Access Token (classic or fine-grained) with read access to target repositories
GITHUB_TOKEN=your_github_personal_access_token_here

# AI Engine (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./relaypoint.db

# Storage Directories
DATA_CACHE_DIR=./.cache
REPORT_OUTPUT_DIR=./generated_reports

# Ingestion Controls & Safety Limits
MAX_COMMITS=50
MAX_ISSUES=30
MAX_PULL_REQUESTS=30
MAX_CONTENT_LENGTH=8000
GITHUB_REQUEST_TIMEOUT=15
GIT_SUBPROCESS_TIMEOUT=15
GEMINI_REQUEST_TIMEOUT=90
GEMINI_MAX_RETRIES=0
MAX_CONTEXT_CHUNKS=20
MAX_PROMPT_CHARS=35000
